# Seeded admin password. REQUIRED and must be 16+ characters.
# Generate with: openssl rand -base64 24
# Server refuses to seed the admin if this is missing or short.
ADMIN_PASS=

# Mongo root credentials. REQUIRED — no defaults are provided.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# The URL for MongoDB. Format: mongodb://[username:password@]host:port/database
# Substitute MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD into this value.
# After running the app-scoped user migration (docs/production-ready.md M1),
# switch this to: mongodb://novellier_app:<password>@mongodb:27017/novellier?authSource=novellier
MONGO_URL=
MONGO_DB=novellier

# The URL for the ChromaDB vector database API
CHROMA_URL=http://chromadb:8000
OLLAMA_URL=http://ollama:11434

EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=gemma2:2b
LLM_TEMPERATURE=0.7 # Controls randomness. Higher = more random, lower = more deterministic.
LLM_NUM_PREDICT=150 # Tokens to predict per response.

AI_STREAM_CONCURRENCY=1
AI_JOB_QUEUE_CONCURRENCY=1

# REQUIRED. Generate with: openssl rand -base64 48
# The server will refuse to start with an empty, short (<32 char), or known-weak secret.
JWT_SECRET=
JWT_EXPIRATION=24h # jsonwebtoken format: '15m', '2h', '7d', '24h'

# Comma-separated list of origins permitted by CORS (no trailing slash).
# Required once the app is exposed via Cloudflare Tunnel. Example:
#   ALLOWED_ORIGINS=https://novellier.dev,https://www.novellier.dev
ALLOWED_ORIGINS=

COMPOSE_PROJECT_NAME=novellier-app
COMPOSE_NETWORK=novellier-app_novellier-network

DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# YouTrack demo profile — only consumed when running `docker compose --profile youtrack`.
YOUTRACK_TOKEN=
# Credentials for the dedicated Novellier service account used by the advisor proxy.
# Create this account in Novellier under Admin > Users before starting the profile.
NOVELLIER_ADMIN_USER=app_youtrack_admin
NOVELLIER_ADMIN_PASS=
